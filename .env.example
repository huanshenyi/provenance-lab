# OpenAI API key (server-side only; never exposed to the browser)
OPENAI_API_KEY=

# Verification provider: "openai" (default) or "mock"
# PROVENANCE_PROVIDER=openai
# Mock scenario when PROVENANCE_PROVIDER=mock:
#   detected | c2pa_only | synthid_only | not_detected | error_no_access | error_rate_limited | error_timeout
# PROVENANCE_MOCK_SCENARIO=detected

# Optional settings
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=30000
# RATE_LIMIT_PER_MINUTE=10
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/provenance-lab
